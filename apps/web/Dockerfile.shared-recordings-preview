FROM node:22-bookworm-slim AS build

WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY patches ./patches
COPY apps/web ./apps/web
COPY packages/api-client ./packages/api-client
COPY packages/changelog ./packages/changelog
COPY packages/design-system ./packages/design-system
COPY packages/editor ./packages/editor
COPY packages/pricing ./packages/pricing
COPY packages/store ./packages/store
COPY packages/supabase ./packages/supabase
COPY packages/ui ./packages/ui
COPY packages/user-error ./packages/user-error
COPY packages/utils ./packages/utils
COPY plugins/opener2 ./plugins/opener2
RUN pnpm install --frozen-lockfile --filter @anlg/web...

ARG VITE_APP_URL
ARG VITE_API_URL
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ENV VITE_APP_URL=$VITE_APP_URL \
    VITE_API_URL=$VITE_API_URL \
    VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY \
    SUPABASE_URL=$VITE_SUPABASE_URL \
    SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY \
    ANARLOG_SHARED_RECORDINGS_PREVIEW=1
RUN pnpm -F @anlg/ui build
RUN pnpm -F @anlg/web build:shared-recordings-preview

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
    ANARLOG_SHARED_RECORDINGS_PREVIEW=1 \
    HOST=0.0.0.0
WORKDIR /app
COPY --from=build --chown=node:node /app/apps/web/.output ./
COPY --from=build --chown=node:node /app/apps/web/scripts/start-shared-recordings-preview.mjs ./scripts/start-shared-recordings-preview.mjs
USER node
CMD ["node", "scripts/start-shared-recordings-preview.mjs"]
