{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "E3 Scribe",
  "mainBinaryName": "anarlog",
  "identifier": "com.hyprnote.stable",
  "bundle": {
    "icon": [
      "icons/e3/32x32.png",
      "icons/e3/128x128.png",
      "icons/e3/128x128@2x.png",
      "icons/e3/icon.icns",
      "icons/e3/icon.ico"
    ],
    "linux": {
      "deb": {
        "provides": ["char"],
        "conflicts": ["char"],
        "replaces": ["char"]
      }
    },
    "macOS": {
      "files": {
        "Resources/AppIcon.icns": "icons/e3/icon.icns"
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["anarlog", "hyprnote"] }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://desktop.anarlog.so/update/{{target}}-{{arch}}-{{bundle_type}}/{{current_version}}?channel=stable"
      ]
    }
  }
}
