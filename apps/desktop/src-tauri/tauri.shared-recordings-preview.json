{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "E3 Shared Recordings Preview",
  "mainBinaryName": "e3-shared-recordings-preview",
  "identifier": "ai.e3group.meeting-capture-shared-preview",
  "build": {
    "runner": "cargo",
    "features": [
      "direct-distribution",
      "disable-analytics"
    ]
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "externalBin": [
      "binaries/char-chrome-native-host",
      "binaries/check-permissions",
      "resources/cli/anarlog-cli"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "e3-shared-recordings-preview"
        ]
      }
    },
    "updater": {
      "active": false,
      "endpoints": []
    }
  }
}
