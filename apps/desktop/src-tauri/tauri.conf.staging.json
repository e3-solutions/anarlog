{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "E3 Scribe Staging",
  "mainBinaryName": "anarlog-staging",
  "identifier": "com.hyprnote.staging",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["anarlog-staging", "hyprnote-staging"]
      }
    },
    "updater": {
      "active": false
    }
  },
  "bundle": {
    "icon": [
      "icons/e3/32x32.png",
      "icons/e3/128x128.png",
      "icons/e3/128x128@2x.png",
      "icons/e3/icon.icns",
      "icons/e3/icon.ico"
    ],
    "macOS": {
      "files": {
        "Resources/mlx-swift_Cmlx.bundle/default.metallib": "resources/mlx.metallib",
        "Resources/AppIcon.icns": "icons/e3/icon.icns"
      },
      "dmg": {
        "background": "assets/dmg-background-staging.png"
      }
    }
  }
}
