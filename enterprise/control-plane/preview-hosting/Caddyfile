{
	admin off
	auto_https off
}

:{$PORT} {
	request_body {
		max_size 140MB
	}
	header {
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
		-Server
	}
	handle /health {
		respond "ready" 200
	}
	@backend path /v1/* /nango/*
	handle @backend {
		reverse_proxy 127.0.0.1:8789
	}
	handle {
		respond 404
	}
}
